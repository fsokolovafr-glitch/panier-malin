# Безопасные настройки локального запуска
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Локальные данные не попадают в Git
DATA_DIR=./var/data
DATABASE_PATH=./var/data/panier_malin.sqlite3
RECEIPTS_DIR=./var/receipts
EXPORTS_DIR=./var/exports

# Денежные настройки
DEFAULT_CURRENCY=EUR

# OCR по умолчанию отключён. Секреты задаются только в локальном .env.
OCR_PROVIDER=disabled
OCR_API_KEY=
